# Example systemd unit. Adjust User and paths to your server, then:
#   sudo cp deploy/tradingbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tradingbot
[Unit]
Description=Nifty 50 RSI Swing Trading Bot
After=network.target

[Service]
Type=simple
User=trader
WorkingDirectory=/opt/nifty50-rsi-swing-bot
ExecStart=/opt/nifty50-rsi-swing-bot/.venv/bin/python trading_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
